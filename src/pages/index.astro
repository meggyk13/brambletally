    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        els.forEach(function (e) { io.observe(e); });
      })();

      (function () {
        var checkSvg = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>';
        var cards = [
          {
            kicker: 'Captured', prompt: 'What should this become?',
            title: '“Order more elastic before the trim run”',
            project: false, primary: '→ Project'
          },
          {
            kicker: 'Solstice feast garb', prompt: 'No deadline set.',
            title: 'Add one, or leave it open-ended.',
            project: true, primary: 'Save',
            steps: [
              { title: 'Order the wool broadcloth', done: true },
              { title: 'Cut the bodice pieces', done: false },
              { title: 'Fit the collar', done: false }
            ]
          },
          {
            kicker: 'Herbal tincture research', prompt: 'What’s the first step?',
            title: 'Break it into something you can start today.',
            project: true, primary: 'Add step', steps: []
          },
          {
            kicker: 'Repaint the shed', prompt: 'No category yet.',
            categoryPicker: true,
            project: true, primary: 'Save',
            steps: [
              { title: 'Buy exterior paint', done: false },
              { title: 'Scrape the old paint off the trim', done: false }
            ]
          }
        ];
        var i = 0;
        var card = document.getElementById('shuffleDemoCard');
        var kicker = document.getElementById('shuffleDemoKicker');
        var edit = document.getElementById('shuffleDemoEdit');
        var prompt = document.getElementById('shuffleDemoPrompt');
        var title = document.getElementById('shuffleDemoTitle');
        var category = document.getElementById('shuffleDemoCategory');
        var stepsBtn = document.getElementById('shuffleDemoSteps');
        var stepList = document.getElementById('shuffleDemoStepList');
        var primaryBtn = document.getElementById('shuffleDemoPrimary');
        var skipBtn = document.getElementById('shuffleDemoSkip');
        if (!card || !skipBtn) return;

        function renderSteps() {
          var c = cards[i];
          stepList.innerHTML = '';
          if (!c.steps || !c.steps.length) {
            var empty = document.createElement('div');
            empty.className = 'shuffle-demo-step-empty';
            empty.textContent = 'No steps yet — add the first one.';
            stepList.appendChild(empty);
            return;
          }
          c.steps.forEach(function (s) {
            var row = document.createElement('div');
            row.className = 'shuffle-demo-step' + (s.done ? ' is-done' : '');
            row.innerHTML =
              '<span class="shuffle-demo-step-box">' + checkSvg + '</span><span>' + s.title + '</span>';
            row.addEventListener('click', function () {
              s.done = !s.done;
              row.classList.toggle('is-done', s.done);
            });
            stepList.appendChild(row);
          });
        }
        function render() {
          var c = cards[i];
          kicker.textContent = c.kicker;
          prompt.textContent = c.prompt;
          title.textContent = c.title || '';
          title.hidden = !!c.categoryPicker;
          category.hidden = !c.categoryPicker;
          category.value = '';
          primaryBtn.textContent = c.primary;
          edit.hidden = !c.project;
          stepsBtn.hidden = !c.project;
          stepsBtn.classList.remove('open');
          stepList.hidden = true;
          renderSteps();
        }
        function advance() {
          card.classList.add('is-changing');
          setTimeout(function () {
            i = (i + 1) % cards.length;
            render();
            card.classList.remove('is-changing');
          }, 160);
        }
        stepsBtn.addEventListener('click', function () {
          var open = stepList.hidden;
          stepList.hidden = !open;
          stepsBtn.classList.toggle('open', open);
        });
        // Save / Add step / → Project and Edit… are where someone stops
        // playing with a canned example and means it for real — send them
        // to account creation instead of just cycling the demo. Skip and the
        // step checkboxes stay local; those are just "show me another one."
        function toApp() { window.location.href = '/app'; }
        primaryBtn.addEventListener('click', toApp);
        edit.addEventListener('click', toApp);
        skipBtn.addEventListener('click', advance);
        renderSteps();
      })();

      (function () {
        // Real palette values, mirrored from public/app.css (:root[data-theme]).
        var PALETTES = {
          bramble: {
            light: { bg:'#f3ecdc', card:'#fbf6ea', elevated:'#eadfc8', border:'#e0d4b8', 'border-strong':'#a89670', text:'#2a2230', 'text-sub':'#4a3f4e', 'text-muted':'#6f6374', accent:'#6b3457', 'accent-2':'#4b6b3a', 'on-accent':'#ffffff', gold:'#9a7526' },
            dark:  { bg:'#1e1a22', card:'#292330', elevated:'#342c3c', border:'#3d3545', 'border-strong':'#625770', text:'#ece3d6', 'text-sub':'#c7bcae', 'text-muted':'#948a83', accent:'#c17ba3', 'accent-2':'#8fb073', 'on-accent':'#241a20', gold:'#d8b768' }
          },
          hearth: {
            light: { bg:'#f6eede', card:'#fdf8ec', elevated:'#f0e2c9', border:'#e6d7bb', 'border-strong':'#b7a074', text:'#33261c', 'text-sub':'#544335', 'text-muted':'#7a6857', accent:'#a8482b', 'accent-2':'#8a6a1f', 'on-accent':'#ffffff', gold:'#a9781f' },
            dark:  { bg:'#211a15', card:'#2c2319', elevated:'#382d20', border:'#423525', 'border-strong':'#6b5a40', text:'#efe4d2', 'text-sub':'#cdbfa8', 'text-muted':'#a1917a', accent:'#d97a55', 'accent-2':'#d0a94e', 'on-accent':'#241a12', gold:'#dcb35f' }
          },
          fen: {
            light: { bg:'#e9ece4', card:'#f4f6ef', elevated:'#dde2d5', border:'#d0d6c6', 'border-strong':'#97a186', text:'#20302b', 'text-sub':'#3b4a44', 'text-muted':'#5f6d66', accent:'#2f6b6b', 'accent-2':'#54763a', 'on-accent':'#ffffff', gold:'#8f7d33' },
            dark:  { bg:'#161c1a', card:'#1f2724', elevated:'#29332f', border:'#333f3a', 'border-strong':'#57655e', text:'#e4e9df', 'text-sub':'#bdc5ba', 'text-muted':'#87918a', accent:'#5cb0ab', 'accent-2':'#8bab63', 'on-accent':'#131c17', gold:'#c3b06a' }
          }
        };
        var swatches = document.querySelectorAll('.sw[data-palette]');
        var caption = document.getElementById('paletteCaption');
        if (!swatches.length) return;
        function apply(id, name) {
          var mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          var vars = (PALETTES[id] || PALETTES.bramble)[mode];
          var root = document.documentElement.style;
          Object.keys(vars).forEach(function (k) { root.setProperty('--' + k, vars[k]); });
          swatches.forEach(function (sw) {
            var active = sw.dataset.palette === id;
            sw.classList.toggle('is-active', active);
            sw.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          if (caption) {
            caption.textContent = id === 'bramble'
              ? 'This whole page just changed. Sign in and it follows you everywhere.'
              : 'That’s ' + name + ', live on this page. Sign in and it follows you everywhere.';
          }
        }
        swatches.forEach(function (sw) {
          sw.addEventListener('click', function () { apply(sw.dataset.palette, sw.dataset.name); });
        });
      })();

      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (me) {
          if (!me || !me.user) return;
          document.querySelectorAll('a.signin').forEach(function (a) { a.textContent = 'Open your projects'; });
          document.querySelectorAll('a.cta[href="/app"]').forEach(function (a) {
            if (a.textContent.trim() === 'Get started') a.textContent = 'Open your projects';
          });
        })
        .catch(function () {});
    </script>
