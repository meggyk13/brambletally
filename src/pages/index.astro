---
// Brambletally — a full-screen client app. Deliberately not wrapped in a shared
// layout: it renders its own <html> shell and mounts the client app into #bt-app.
// Palette + type: İznik / EB Garamond / IBM Plex Mono.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Brambletally</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="A project tracker for craft, research, and event work." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      try {
        var t = localStorage.getItem('bt-theme');
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..600&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/app.css" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  </head>
  <body>
    <div id="bt-app"></div>
    <script src="/app.js" is:inline></script>
  </body>
</html>
