{
  "name": "brambletally",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  // Runs before `wrangler dev` and `wrangler deploy`, so a Cloudflare
  // Workers Build that only calls `wrangler deploy` still produces dist/.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brambletally",
      // Fill in after: npx wrangler d1 create brambletally
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
