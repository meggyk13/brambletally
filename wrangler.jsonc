{
  "name": "brambletally",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  // Runs before `wrangler dev` and `wrangler deploy`, so a Cloudflare
  // Workers Build that only calls `wrangler deploy` still produces dist/.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // "0 15 * * 0": Sunday 15:00 UTC ≈ 08:00 America/Los_Angeles — weekly digest.
  // "0 12 * * *": daily 12:00 UTC — due-date reminders.
  // Both dispatched from the scheduled() handler in worker/index.js.
  "triggers": {
    "crons": ["0 15 * * 0", "0 12 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brambletally",
      "database_id": "77c8c947-6d7f-4d5c-aac6-8170f9edd5aa"
    }
  ]
}
