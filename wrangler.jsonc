{
  "name": "brambletally",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  // Runs before `wrangler dev` and `wrangler deploy`, so a Cloudflare
  // Workers Build that only calls `wrangler deploy` still produces dist/.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // "0 15 * * 1": Sunday 15:00 UTC ≈ 08:00 America/Los_Angeles — weekly digest.
  //   Cloudflare's day-of-week is 1-7 (1 = Sunday), NOT the Unix 0-6; "0" is
  //   rejected as an invalid cron string on deploy.
  // "0 12 * * *": daily 12:00 UTC — due-date reminders.
  // scheduled() in worker/index.js dispatches by exact string match; keep these
  // byte-for-byte in sync with DIGEST_CRON / REMINDERS_CRON in
  // worker/api/lib/constants.js.
  "triggers": {
    "crons": ["0 15 * * 1", "0 12 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brambletally",
      "database_id": "77c8c947-6d7f-4d5c-aac6-8170f9edd5aa"
    }
  ]
}
