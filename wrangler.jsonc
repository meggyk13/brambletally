{
  "name": "brambletally",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brambletally",
      // Fill in after: npx wrangler d1 create brambletally
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
