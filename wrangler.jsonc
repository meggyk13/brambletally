{
  "name": "brambletally",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  // Runs before `wrangler dev` and `wrangler deploy`, so a Cloudflare
  // Workers Build that only calls `wrangler deploy` still produces dist/.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Sunday 15:00 UTC ≈ 08:00 America/Los_Angeles — the weekly notification
  // digest (worker/api/lib/digest.js via the scheduled() handler).
  "triggers": {
    "crons": ["0 15 * * 0"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brambletally",
      "database_id": "77c8c947-6d7f-4d5c-aac6-8170f9edd5aa"
    }
  ]
}
